*.yaml text eol=lf
*.yml text eol=lf
*.npz binary
*.npy binary
*.px4 binary
*.ulg binary
*.pdf binary
*.png binary
*.jpg binary
*.webp binary
*.csv text eol=lf
*.toml text eol=lf
*.ps1 text eol=crlf

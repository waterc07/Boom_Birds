<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>boom_birds_bringup</name>
  <version>0.1.0</version>
  <description>生命周期编排与生产链路启动。</description>
  <maintainer email="waterc@example.invalid">waterc</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>boom_birds_interfaces</depend>
  <depend>boom_birds_control</depend>
  <exec_depend>boom_birds_sensing</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>quadrotor_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <!-- PyPI 侧依赖（pymavlink/pyserial）：本机 rosdep 没有 python3-pymavlink 规则
       （rosdep resolve 报 no rosdep rule），因此不写成无法解析的 rosdep 键，
       而由 companion/ros2_ws/requirements-mavlink.txt 固定版本、
       tools/setup_python_env.sh 的 install 选项装入工作空间 venv；
       test/test_config_single_source.py 核对这条依赖没有被漏掉。 -->
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>stereo_depth</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
